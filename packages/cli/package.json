{
  "name": "@pilot/cli",
  "version": "0.0.0",
  "private": true,
  "description": "The `pilot` command: project setup, the local bridge the overlay talks to, and the MCP server agents connect to.",
  "type": "module",
  "bin": {
    "pilot": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node22 --clean",
    "dev": "tsup src/index.ts --format esm --target node22 --watch",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "tsup": "^9.0.0"
  },
  "dependencies": {
    "@pilot/protocol": "workspace:^"
  }
}
