{
  "name": "usepilot",
  "version": "0.1.0",
  "license": "FSL-1.1-MIT",
  "description": "Pilot: take the controls from your coding agent and edit your UI in the browser. A dev-only design overlay that hands your edits to the agent as plain-CSS intent.",
  "keywords": ["design", "overlay", "css", "tailwind", "agent", "mcp", "devtools"],
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/pilot.js"
    },
    "./auto": {
      "types": "./types/auto.d.ts",
      "default": "./dist/pilot-auto.js"
    }
  },
  "sideEffects": ["./dist/pilot-auto.js"],
  "files": ["dist", "types", "README.md", "LICENSE.md"],
  "scripts": {
    "build": "pnpm --filter @pilot/overlay build && rm -rf dist && cp -R ../overlay/dist ./dist",
    "prepack": "pnpm run build && cp ../../LICENSE.md ./LICENSE.md",
    "postpack": "rm -f ./LICENSE.md"
  }
}
